# ---------------------------------------------------------------------------
# Origami Studio — ignore rules
#
# Tracked on purpose: package-lock.json so a judge cloning the repository gets
# the exact dependency tree that was tested, plus LICENSE, README.md, and
# everything under src/.
#
# Deliberately NOT tracked: internal planning material. The PRD, the rule
# snapshot, and the agent steering files are working notes, not part of the
# shipped product, and the submission does not require them.
# ---------------------------------------------------------------------------

# Internal planning material and IDE agent configuration
/docs/
/.kiro/

# Dependencies
/node_modules

# Vite build output
/dist
/dist-ssr

# Caches
*.tsbuildinfo
.eslintcache
.cache/

# Test output
/coverage

# This project needs no environment variables. If one of these ever appears,
# something has gone wrong in the design: there is no server and no account.
.env
.env.*
!.env.example
*.pem
*.key

# Logs
*.log
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# Hosting providers
.vercel
.netlify

# Editors and IDEs
.idea/
*.iml
*.swp
*.swo
.vscode/*
!.vscode/extensions.json

# Operating system cruft
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
